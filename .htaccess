# Regeln für Apache/LiteSpeed. Domains stehen nur in config.php (base_url, legacy_hosts).
Options -Indexes
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Frühere Domains und www leitet lib/bootstrap.php anhand von config.php um (legacy_hosts).

# Authorization-Header an PHP durchreichen (für Bearer-Token)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Inhaltlicher Export: /b/<key>/export
RewriteRule ^b/([a-z0-9]{16})/export/?$ export.php?key=$1 [L,QSA]

# Aktivitäten (Zielscheibe): /a/<key>
RewriteRule ^a/([a-z0-9]{16})/?$ activity.php?key=$1 [L,QSA]

# Board-Links: /b/<key>
RewriteRule ^b/([a-z0-9]{16})/?$ board.php?key=$1 [L,QSA]

# Schnittstelle: /api/...
RewriteRule ^api/(.*)$ api/index.php?route=$1 [L,QSA]

# Connector: /mcp/<token>
RewriteRule ^mcp/([a-f0-9]{48})/?$ mcp/index.php?token=$1 [L,QSA]

# Bibliothek unter eigenem Pfad (config.php: admin_path): /<pfad>/<seite>.php -> admin/<seite>.php.
# Die Seiten prüfen selbst, ob der Pfad stimmt (sonst 404). /<pfad> und /<pfad>/ übernimmt board.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9][a-z0-9-]{1,30}[a-z0-9])/([a-z_]+\.php)$ admin/$2 [L,QSA]

# Kurzlinks: /<kurzwort> (board.php reicht Kurzwörter von Aktivitäten an activity.php weiter)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9][a-z0-9-]{1,30}[a-z0-9])/?$ board.php?slug=$1 [L,QSA]
</IfModule>

# Interne Dateien sperren
<FilesMatch "^(config\.php|config\.example\.php|[^/]*\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(lib|lang|vendor|\.git)(/|$)

# Uploads: 10 MB
<IfModule mod_php.c>
php_value upload_max_filesize 10M
php_value post_max_size 12M
</IfModule>
