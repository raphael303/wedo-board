# Regeln für Apache/LiteSpeed. Domains stehen nur in config.php (base_url, legacy_hosts).
Options -Indexes
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Frühere Domains und www leitet lib/bootstrap.php anhand von config.php um (legacy_hosts).

# Authorization-Header an PHP durchreichen (für Bearer-Token)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Inhaltlicher Export: /b/<key>/export
RewriteRule ^b/([a-z0-9]{16})/export/?$ export.php?key=$1 [L,QSA]

# Gemeinschaftsprüfung: Druckseiten /a/<key>/print
RewriteRule ^a/([a-z0-9]{16})/print/?$ exam_print.php?key=$1 [L,QSA]

# Aktivitäten (Zielscheibe): /a/<key>
RewriteRule ^a/([a-z0-9]{16})/?$ activity.php?key=$1 [L,QSA]

# Board-Links: /b/<key>
RewriteRule ^b/([a-z0-9]{16})/?$ board.php?key=$1 [L,QSA]

# Schnittstelle: /api/...
RewriteRule ^api/(.*)$ api/index.php?route=$1 [L,QSA]

# Connector pro Arbeitsbereich (seit 0.23.0, Anmeldung über OAuth): /mcp/private und /mcp/o/<okey>
RewriteRule ^mcp/private/?$ mcp/index.php?ws=private [L]
RewriteRule ^mcp/o/([a-z0-9]{16})/?$ mcp/index.php?ws=$1 [L]
# Früherer Connector: /mcp/<token> (gilt bis zum Ablauf des alten Tokens)
RewriteRule ^mcp/([a-f0-9]{48})/?$ mcp/index.php?token=$1 [L]

# Autorisierungsserver (seit 0.23.0): Metadaten, Registrierung, Zustimmung, Tokens
RewriteRule ^\.well-known/oauth-authorization-server/?$ oauth.php?r=as-meta [L]
RewriteRule ^\.well-known/oauth-protected-resource/(mcp/private|mcp/o/[a-z0-9]{16})/?$ oauth.php?r=pr-meta&res=$1 [L]
RewriteRule ^oauth/(register|authorize|token|revoke)/?$ oauth.php?r=$1 [L,QSA]

# Seiten der Nutzerverwaltung (seit 0.22.0): /login, /signup, /invite, /account, /manage, /help, /test
RewriteRule ^(login|logout|signup|invite|account|manage|help|test)(?:/([a-z0-9-]+))?/?$ page.php?p=$1&s=$2 [L,QSA]

# Bibliothek unter eigenem Pfad (config.php: admin_path): /<pfad>/<seite>.php -> admin/<seite>.php.
# Die Seiten prüfen selbst, ob der Pfad stimmt (sonst 404). /<pfad> und /<pfad>/ übernimmt board.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9][a-z0-9-]{1,30}[a-z0-9])/([a-z_]+\.php)$ admin/$2 [L,QSA]

# Kurzlinks: /<kurzwort> (board.php reicht Kurzwörter von Aktivitäten an activity.php weiter)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9][a-z0-9-]{1,30}[a-z0-9])/?$ board.php?slug=$1 [L,QSA]
</IfModule>

# Sicherheits-Kopfzeilen (seit 0.19.2). dev-router.php setzt für die lokale Entwicklung dieselben Werte;
# tools/test.sh prüft, dass beide übereinstimmen. Die Content-Security-Policy ist vorerst nur «Report-Only»:
# Verstösse erscheinen in der Browser-Konsole, blockiert wird nichts.
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Interne Dateien sperren (dev-router.php ist nur für php -S auf dem eigenen Rechner gedacht)
<FilesMatch "^(config\.php|config\.example\.php|dev-router\.php|[^/]*\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(lib|lang|vendor|tools|docs|pages|\.git|\.cyon)(/|$)

# Uploads: 10 MB
<IfModule mod_php.c>
php_value upload_max_filesize 10M
php_value post_max_size 12M
</IfModule>
